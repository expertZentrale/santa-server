# Copy to .devcontainer/.env (not in git) and rebuild the devcontainer: the file is read when the container is
# created. Then the VS Code task "Santa Server" starts the dev server with the new values (if it was already running:
# "Tasks: Restart Running Task").
#
# Every variable of the configuration table of the README works here, a value here wins over the defaults of the
# devcontainer (santa_server/settings_dev.py). The tests always run with the defaults of the sign-in and the name.

# GitHub token for the release sources and the catalog search: without it GitHub allows 60 API requests
# per hour and 10 searches per minute for the public IP. A fine-grained token with "Public repositories
# (read-only)" and no permissions is enough: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Default time zone of the server, e.g. Europe/Berlin (default UTC). The console shows the times in the time
# zone of the browser, or of the profile, anyway.
TIME_ZONE=

# Sign-in with your OpenID Connect provider (the redirect URI is http://localhost:8000/oidc/callback/)
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
# OIDC_JWKS_ENDPOINT=
# OIDC_PROVIDER_NAME=Microsoft
# OIDC_PROVIDER_ICON=microsoft

# More examples: the name, the metrics, a real mail server instead of Mailpit (http://localhost:8025)
# SANTA_SERVER_NAME=Santa Dev
# METRICS_ENABLED=false
# EMAIL_HOST=smtp.example.com
