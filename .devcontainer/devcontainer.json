{
	"name": "Santa Server",
	"dockerComposeFile": "docker-compose.yml",
	"service": "web",
	"workspaceFolder": "/workspaces/santa-server",
	"containerEnv": {
		"DJANGO_SETTINGS_MODULE": "santa_server.settings_dev",
		"DB_HOST": "mssql",
		"DB_PORT": "1433",
		"DB_NAME": "santa",
		"DB_USER": "sa",
		"DB_PASSWORD": "SantaDev!Passw0rd",
		"REDIS_URL": "redis://redis:6379/1"
	},
	"remoteUser": "dev",
	"forwardPorts": [8000, "mailpit:8025"],
	"portsAttributes": {
		"8000": {"label": "Santa Server"},
		"mailpit:8025": {"label": "Mailpit (e-mails)"}
	},
	"postCreateCommand": ".devcontainer/setup.sh",
	"customizations": {
		// the task "Santa Server" (.vscode/tasks.json) starts the dev server when the folder opens, once automatic
		// tasks are allowed in your user settings (VS Code takes that setting from nowhere else)
		"vscode": {
			"extensions": [
				"ms-python.python",
				"charliermarsh.ruff",
				"batisteo.vscode-django"
			]
		}
	}
}
